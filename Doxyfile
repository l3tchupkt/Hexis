PROJECT_NAME           = "Hexis"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "Universal Hardware Hacking & Firmware Analysis Framework"

OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

INPUT                  = libhexis/include libhexis/src
FILE_PATTERNS          = *.c *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/*

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html

GENERATE_LATEX         = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
